# Settings read from .env: which model /answer runs on, and the Bedrock
# credentials the hosted model and the corpus scripts call with.
#
# Copy this file to .env and fill in the values:
#
#     cp .env.example .env
#
# .env is gitignored. This template is committed, so never put a real key in
# it. None of this is needed to search, or to answer from the local model.
# A variable exported in the shell wins over the same one in .env.

# Which model /answer runs on: "ollama" (local, the default, free) or
# "bedrock" (hosted, billed per call). A key below does not select Bedrock;
# only this does. Leave it commented out to answer from the local model, or
# choose per start with CORPUS_QUERY_MODEL_BACKEND=bedrock on the command line.
# CORPUS_QUERY_MODEL_BACKEND=bedrock

# A Bedrock API key. docs/provisioning.md is where one comes from.
AWS_BEARER_TOKEN_BEDROCK=

# The region to call Bedrock in. The model is named as a US cross-region
# inference profile, so this is a US region.
AWS_REGION=us-east-1

# Not read from this file: the tracing switches (CORPUS_QUERY_TRACE_CONSOLE,
# OTEL_SDK_DISABLED, OTEL_EXPORTER_OTLP_ENDPOINT, and the other OTEL_*
# settings) are read only from the exported environment. See
# docs/tracing.md.
